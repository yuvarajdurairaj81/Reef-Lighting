# ---------- Server ----------
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (the frontend URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
APP_URL=http://localhost:5173

# ---------- Database ----------
DATABASE_URL=postgresql://reef:reef@localhost:5432/reef_lighting?schema=public

# ---------- Auth (generate each with: openssl rand -base64 48) ----------
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=1
REMEMBER_ME_TTL_DAYS=30
# 32-byte key, base64 encoded (openssl rand -base64 32). Encrypts MFA secrets at rest.
MFA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
REQUIRE_EMAIL_VERIFICATION=true

# ---------- WebAuthn / Passkeys ----------
# Must equal the domain the user sees in the browser (no scheme, no port).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Reef Lighting
# Full origin(s) of the frontend, comma separated
WEBAUTHN_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- Email ----------
# Leave SMTP_HOST empty to print emails to the server log instead of sending.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Reef Lighting <no-reply@reef.local>"

# ---------- IoT ----------
# simulated | ble | wifi | mqtt  (only "simulated" is implemented in this release)
IOT_ADAPTER=simulated
# 0..1 probability that a simulated operation fails, for testing error paths
SIM_FAILURE_RATE=0
MQTT_URL=mqtt://localhost:1883
